{
  "name": "sim-host",
  "version": "1.0.0",
  "description": "Zero-dependency local host for HTML/JS simulations with live reload and an auto-generated index.",
  "private": true,
  "type": "module",
  "main": "server.mjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "node server.mjs --verbose",
    "list": "node server.mjs --list",
    "host": "bash scripts/host.sh",
    "host:status": "bash scripts/host.sh --status",
    "host:stop": "bash scripts/host.sh --stop-all",
    "ports": "node scripts/list-ports.mjs",
    "lint": "node scripts/check-project.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [
    "simulation",
    "canvas",
    "live-reload",
    "static-server",
    "zero-dependency"
  ],
  "license": "MIT"
}
